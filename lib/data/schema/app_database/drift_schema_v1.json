  "fixed_sql": [
    {
      "name": "company_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"company_profile\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"company_name\" TEXT NOT NULL, \"legal_name\" TEXT NULL, \"address\" TEXT NOT NULL DEFAULT '', \"phone_numbers\" TEXT NOT NULL DEFAULT '', \"tagline\" TEXT NOT NULL DEFAULT '', \"signatory\" TEXT NOT NULL DEFAULT '', \"vat_rate_basis_points\" INTEGER NOT NULL DEFAULT 1500, \"vat_number\" TEXT NULL, \"tin_number\" TEXT NULL, \"supported_currencies\" TEXT NOT NULL DEFAULT 'USD,ZiG', \"logo_path\" TEXT NULL, \"quote_prefix\" TEXT NOT NULL DEFAULT 'QT-', \"invoice_prefix\" TEXT NOT NULL DEFAULT 'INV-', \"receipt_prefix\" TEXT NOT NULL DEFAULT 'RC-', \"number_padding\" INTEGER NOT NULL DEFAULT 4, \"default_validity_days\" INTEGER NOT NULL DEFAULT 30);"
        }
      ]
    },
    {
      "name": "customers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"customers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"location\" TEXT NOT NULL DEFAULT '', \"phone\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '', \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "catalog_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalog_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"designation\" TEXT NOT NULL, \"unit\" TEXT NOT NULL DEFAULT '', \"default_unit_price_minor\" INTEGER NULL, \"is_section\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_section\" IN (0, 1)), \"section_id\" INTEGER NULL REFERENCES catalog_items (id), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"document_type\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"document_number\" TEXT NULL UNIQUE, \"customer_id\" INTEGER NULL REFERENCES customers (id), \"source_quote_id\" INTEGER NULL UNIQUE REFERENCES documents (id), \"replaces_document_id\" INTEGER NULL REFERENCES documents (id), \"currency_code\" TEXT NOT NULL, \"vat_rate_basis_points\" INTEGER NOT NULL DEFAULT 1500, \"discount_kind\" TEXT NOT NULL DEFAULT 'none', \"discount_value\" INTEGER NOT NULL DEFAULT 0, \"notes\" TEXT NOT NULL DEFAULT '', \"terms_snapshot\" TEXT NOT NULL DEFAULT '', \"customer_name_snapshot\" TEXT NOT NULL DEFAULT '', \"customer_location_snapshot\" TEXT NOT NULL DEFAULT '', \"customer_phone_snapshot\" TEXT NOT NULL DEFAULT '', \"company_name_snapshot\" TEXT NOT NULL DEFAULT '', \"legal_name_snapshot\" TEXT NOT NULL DEFAULT '', \"address_snapshot\" TEXT NOT NULL DEFAULT '', \"phone_numbers_snapshot\" TEXT NOT NULL DEFAULT '', \"tagline_snapshot\" TEXT NOT NULL DEFAULT '', \"signatory_snapshot\" TEXT NOT NULL DEFAULT '', \"vat_number_snapshot\" TEXT NULL, \"tin_number_snapshot\" TEXT NULL, \"logo_path_snapshot\" TEXT NULL, \"validity_days\" INTEGER NOT NULL DEFAULT 30, \"created_at\" INTEGER NOT NULL, \"issued_at\" INTEGER NULL, \"expires_at\" INTEGER NULL, \"voided_at\" INTEGER NULL, \"void_reason\" TEXT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "document_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"document_id\" INTEGER NOT NULL REFERENCES documents (id), \"sort_order\" INTEGER NOT NULL, \"is_section_header\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_section_header\" IN (0, 1)), \"designation\" TEXT NOT NULL, \"unit\" TEXT NOT NULL DEFAULT '', \"unit_price_minor\" INTEGER NULL, \"quantity_milli\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_id\" INTEGER NOT NULL REFERENCES documents (id), \"currency_code\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL, \"method\" TEXT NOT NULL, \"paid_at\" INTEGER NOT NULL, \"entry_type\" TEXT NOT NULL DEFAULT 'payment', \"reverses_payment_id\" INTEGER NULL UNIQUE REFERENCES payments (id), \"receipt_document_id\" INTEGER NULL UNIQUE REFERENCES documents (id), \"note\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "terms_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"terms_templates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "number_sequences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"number_sequences\" (\"document_type\" TEXT NOT NULL, \"prefix\" TEXT NOT NULL, \"next_number\" INTEGER NOT NULL DEFAULT 1, \"padding\" INTEGER NOT NULL DEFAULT 4, PRIMARY KEY (\"document_type\"));"
        }
      ]
    },
    {
      "name": "audit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_logs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity_type\" TEXT NOT NULL, \"entity_id\" INTEGER NOT NULL, \"action\" TEXT NOT NULL, \"occurred_at\" INTEGER NOT NULL, \"before_summary\" TEXT NULL, \"after_summary\" TEXT NULL, \"actor\" TEXT NOT NULL DEFAULT 'owner');"
        }
      ]
    }
  ]
